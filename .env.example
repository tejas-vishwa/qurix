# ==============================================================================
# QURIX / BIOBYTES ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database
DATABASE_URL="file:./dev.db"
# TURSO_DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# Clerk Authentication (Recommended: Automatic Email Delivery & Verification)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your-clerk-publishable-key"
CLERK_SECRET_KEY="sk_test_your-clerk-secret-key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/register"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/patient/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/patient/dashboard"

# NextAuth / Legacy Auth
NEXTAUTH_SECRET="generate-a-secure-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# AI / OCR Services
# GEMINI_API_KEY="your-gemini-api-key"
# AI_MICROSERVICE_URL="http://localhost:8000/analyze/scan"

# Telehealth (Daily.co)
# DAILY_API_KEY="your-daily-api-key"
# NEXT_PUBLIC_DAILY_DOMAIN="your-domain.daily.co"

# Email Services (MailerSend Magic Links & Transactional)
# MAILERSEND_API_KEY="mlsn.your-mailersend-api-key"
# MAILERSEND_FROM_EMAIL="noreply@qurix.health"
# MAILERSEND_FROM_NAME="QURIX BioBytes"
# EMAIL_USER="your-email@gmail.com"
# EMAIL_PASS="your-google-app-password"

# Cron & Admin Setup
# CRON_SECRET="your-cron-secret-token"
# ADMIN_SETUP_SECRET="your-admin-setup-secret"
# ADMIN_DEFAULT_EMAIL="admin@teamqurix.com"
# ADMIN_DEFAULT_PASSWORD="your-secure-admin-password"

# ==============================================================================
# RATE LIMITING & SECURITY CONFIGURATION
# All thresholds are fully configurable via the environment variables below
# ==============================================================================

# 1. Authentication Endpoints (Stricter limits + Exponential Backoff)
# Paths: /api/auth/*, /api/register, /api/labs/register, /api/doctor/access, etc.
RATE_LIMIT_AUTH_IP_MAX=10                # Max requests per IP within the IP window
RATE_LIMIT_AUTH_IP_WINDOW_SEC=60         # IP window duration in seconds
RATE_LIMIT_AUTH_ACCOUNT_MAX=5            # Max failed attempts before exponential backoff activates
RATE_LIMIT_AUTH_ACCOUNT_WINDOW_SEC=900   # Tracking window for failed attempts (15 mins)
RATE_LIMIT_AUTH_BACKOFF_BASE_SEC=2       # Base backoff delay in seconds
RATE_LIMIT_AUTH_BACKOFF_MULTIPLIER=2     # Multiplier for each subsequent failure (2s -> 4s -> 8s -> 16s...)
RATE_LIMIT_AUTH_BACKOFF_MAX_SEC=900      # Cap on backoff delay in seconds (15 mins)

# 2. Public Endpoints (Moderate limits)
# Paths: /api/doctors, /api/telehealth/join, /api/setup-db, etc.
RATE_LIMIT_PUBLIC_IP_MAX=60              # Max requests per IP
RATE_LIMIT_PUBLIC_WINDOW_SEC=60          # Window duration in seconds (1 minute)

# 3. Authenticated User Actions (Looser limits)
# Paths: /api/reports/*, /api/prescriptions/*, /api/scans/*, /api/appointments/*, etc.
RATE_LIMIT_USER_MAX=200                  # Max requests per authenticated user
RATE_LIMIT_USER_WINDOW_SEC=60            # Window duration in seconds (1 minute)

# 4. AI & Heavy Resource Endpoints
# Paths: /api/analyze-scan, /api/extract-report, /api/generate-summary, etc.
RATE_LIMIT_AI_MAX=20                     # Max heavy AI requests per user/IP
RATE_LIMIT_AI_WINDOW_SEC=60              # Window duration in seconds (1 minute)
