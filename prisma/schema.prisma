generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "sqlite"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String?
  emailVerified DateTime?
  name          String?
  gender        String?
  age           Int?
  location      String?
  role          String    @default("PATIENT") // PATIENT, DOCTOR, ADMIN, LAB_PARTNER
  accountStatus    String    @default("ACTIVE") // ACTIVE, SUSPENDED
  subscriptionTier String    @default("FREE") // "FREE" or "QURIX_PLUS"
  paymentStatus    String    @default("NONE") // "NONE", "PENDING_APPROVAL", "ACTIVE"
  createdAt        DateTime  @default(now())

  // Relations
  reports             Report[]             @relation("PatientReports")
  alerts              HealthAlert[]
  accessCodes         DoctorAccessCode[]
  bookings            LabBooking[]
  doctorProfile       DoctorProfile?
  patientAppointments Appointment[]        @relation("PatientAppointments")
  doctorAppointments  Appointment[]        @relation("DoctorAppointments")
  healthRecords       UserHealthRecord[]
  prescriptions       Prescription[] @relation("PatientPrescriptions")
  scans               MedicalScan[]  @relation("PatientScans")
  activities          ActivityLog[]
  medicineReminders   MedicineReminder[] @relation("PatientReminders")
  medicationReminders MedicationReminder[]
}

model DoctorProfile {
  id             String  @id @default(uuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber  String
  specialization String?
}

model Report {
  id         String    @id @default(uuid())
  patientId  String
  patient    User      @relation("PatientReports", fields: [patientId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  fileData   String? // Base64 encoded file content stored directly in Turso
  fileType   String? // MIME type (e.g. application/pdf)
  status     String    @default("UPLOADED") // UPLOADED, PROCESSING, PARSED, FAILED
  rawText    String?
  parsedJson String?
  aiSummary  String?
  reportDate DateTime?
  labName    String?
  createdAt  DateTime  @default(now())

  metrics      ExtractedMetric[]
  healthRecord UserHealthRecord?
}

model BiomarkerDefinition {
  id          String  @id @default(uuid())
  code        String  @unique // canonical code e.g. HEMOGLOBIN
  displayName String
  unit        String
  refMin      Float?
  refMax      Float?
  category    String?

  metrics ExtractedMetric[]
}

model ExtractedMetric {
  id          String              @id @default(uuid())
  reportId    String
  report      Report              @relation(fields: [reportId], references: [id], onDelete: Cascade)
  biomarkerId String
  biomarker   BiomarkerDefinition @relation(fields: [biomarkerId], references: [id], onDelete: Cascade)
  value       Float
  unit        String
  refMin      Float?
  refMax      Float?
  isAbnormal  Boolean             @default(false)
  createdAt   DateTime            @default(now())
}

model DoctorAccessCode {
  id        String   @id @default(uuid())
  patientId String
  patient   User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  code      String   @unique
  expiresAt DateTime
  maxUses   Int      @default(5)
  usedCount Int      @default(0)
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  usages AccessCodeUsage[]
}

model AccessCodeUsage {
  id         String           @id @default(uuid())
  codeId     String
  code       DoctorAccessCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  accessedAt DateTime         @default(now())
  ipAddress  String?
}

model HealthAlert {
  id        String   @id @default(uuid())
  patientId String
  patient   User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  metricId  String? // Optional reference to ExtractedMetric if we want a hard link
  severity  String   @default("INFO") // INFO, WARNING, CRITICAL
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model LabPartner {
  id               String   @id @default(uuid())
  name             String
  yearEstablished  Int?
  contactPerson    String?
  email            String?  @unique
  passwordHash     String?
  registrationNo   String?
  certificationUrl String?
  operationalScope String?
  logoUrl          String?
  bookingUrl       String?
  commissionPct    Float    @default(0)
  accountStatus    String   @default("pending") // pending, active, rejected
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  bookings         LabBooking[]
}

model LabBooking {
  id        String     @id @default(uuid())
  patientId String
  patient   User       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  labId     String
  lab       LabPartner @relation(fields: [labId], references: [id], onDelete: Cascade)
  status    String     @default("PENDING") // PENDING, CONFIRMED, COMPLETED
  createdAt DateTime   @default(now())
}

model Appointment {
  id            String   @id @default(uuid())
  patientId     String
  patient       User     @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        User     @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
  scheduledTime DateTime
  type          String   @default("OFFLINE") // OFFLINE, ONLINE
  status        String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, COMPLETED
  accessCode    String? // The 6-digit PIN pre-uploaded by patient
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  // Telehealth
  dailyRoomName   String?   @unique
  dailyRoomUrl    String?
  callStartedAt   DateTime?
  callEndedAt     DateTime?
  callDurationSec Int?

  // AI Consultation
  transcript   String?
  aiSummary    String?
  scribeStatus String? @default("PENDING") // PENDING, PROCESSING, DONE, FAILED

  transcriptSegments  ConsultationTranscriptSegment[]
  medicationReminders MedicationReminder[]
}

model ConsultationTranscriptSegment {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  speaker       String // "doctor" | "patient" | "unknown"
  text          String
  confidence    Float?
  startMs       Int?
  endMs         Int?
  createdAt     DateTime    @default(now())
}

model MedicationReminder {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     String
  patient       User        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  drugName      String
  dosage        String
  frequency     String
  duration      String
  nextDoseAt    DateTime?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
}

model UserHealthRecord {
  id        String @id @default(uuid())
  reportId  String @unique
  report    Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  patientId String
  patient   User   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Hardcoded columns for data integrity
  hemoglobin          Float?
  fasting_blood_sugar Float?
  thyroid_tsh         Float?
  ldl_cholesterol     Float?
  hdl_cholesterol     Float?
  triglycerides       Float?
  vitamin_d           Float?
  vitamin_b12         Float?

  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model Prescription {
  id            String   @id @default(uuid())
  patientId     String
  patient       User     @relation("PatientPrescriptions", fields: [patientId], references: [id], onDelete: Cascade)
  fileName      String
  fileUrl       String?
  fileData      String?  // Base64 encoded file content stored directly in Turso
  fileType      String?  // MIME type
  status        String   @default("PARSED") // UPLOADED, PARSED, FAILED
  rawText       String?
  doctorName    String?  // Prescribing doctor name (if extracted)
  medicinesJson String?  // Extracted JSON array of medicines & dosages: [{ name: string, dosage: string, frequency?: string }]
  symptomsJson  String?  // Extracted JSON array or text of symptoms/diagnosis
  vitalsJson    String?  // Extracted JSON object: { temperature?: string, bp?: string, pulse?: string, weight?: string }
  createdAt     DateTime @default(now())

  reminders     MedicineReminder[] @relation("PrescriptionReminders")
}

model MedicineReminder {
  id              String       @id @default(uuid())
  patientId       String
  patient         User         @relation("PatientReminders", fields: [patientId], references: [id], onDelete: Cascade)
  prescriptionId  String?
  prescription    Prescription? @relation("PrescriptionReminders", fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineName    String
  reminderTime    String       // Format "HH:mm" (e.g. "08:00")
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
}

model MedicalScan {
  id               String   @id @default(uuid())
  patientId        String
  patient          User     @relation("PatientScans", fields: [patientId], references: [id], onDelete: Cascade)
  fileName         String
  fileUrl          String?
  fileData         String?  // Base64 encoded scan image content stored directly in Turso / SQLite
  fileType         String?  // MIME type (image/png, image/jpeg, etc.)
  modality         String?  // Chest X-Ray (2D), 3D CT/MRI Volume
  modelUsed        String?  // TorchXRayVision DenseNet-121, MONAI 3D
  overallRisk      String?  // LOW, MODERATE, HIGH, CRITICAL
  maxProbability   Float?
  pathologiesJson  String?  // Extracted JSON array of pathologies & probabilities
  summary          String?
  createdAt        DateTime @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
